{
    "name": "ntentan/dev",
    "description": "A dev tool for use with ntentan",
    "license": "MIT",
    "authors": [
        {
            "name": "Ekow Abaka Ainooson",
            "email": "jainooson@gmail.com"
        }
    ],
    "autoload" : {
        "psr-4" : { 
            "ntentan\\dev\\" : "src/",
            "ntentan\\dev\\tests\\" : "tests/"
        }
    },
    "require": {
        "ekowabaka/clearice" : "@stable",
        "mustache/mustache": "@stable",
        "ntentan/panie": "@stable",
        "ntentan/honam": "@stable",
        "ntentan/ntentan": "@stable",
        "ntentan/kaikai": "@stable",
        "ext-pcntl": "*",
        "scssphp/scssphp": "^2.1.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "@stable",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "phpunit"
    },
    "bin" : ["bin/ntentan"]
}
